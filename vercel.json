{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|mp4|mov|webm|woff|woff2|ttf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/send-otp", "destination": "/api/send-otp.js" },
    { "source": "/api/verify-otp", "destination": "/api/verify-otp.js" },
    { "source": "/api/public/config", "destination": "/api/config.js" },
    { "source": "/api/booking", "destination": "/api/booking.js" },
    { "source": "/api/complete-booking", "destination": "/api/complete-booking.js" },
    { "source": "/api/contact", "destination": "/api/contact.js" },
    { "source": "/api/book-slot", "destination": "/api/book-slot.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/confirmation", "destination": "/confirmation.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ]
}